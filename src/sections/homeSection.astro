<script>
  const headers = {
    Accept: "application/vnd.github.cloak-preview+json", // Required for commit search API
  };

  // Fetch GitHub commit count
  fetch("https://api.github.com/search/commits?q=author:hymndavinci", {
    headers,
  })
    .then((response) => {
      if (!response.ok) {
        throw new Error("bad network response");
      }
      return response.json();
    })
    .then((data) => {
      const commitCount = data.total_count;
      document.getElementById("commit-count").innerText = commitCount;
    })
    .catch((error) => {
      console.error("failed to fetch github commits count:", error);
      document.getElementById("commit-count").innerText = "Error";
    });

  // Fetch GitHub account creation date
  fetch("https://api.github.com/users/hymndavinci")
    .then((response) => {
      if (!response.ok) {
        throw new Error("bad network response");
      }
      return response.json();
    })
    .then((data) => {
      const createdAt = new Date(data.created_at);
      const experienceYears =
        new Date().getFullYear() - createdAt.getFullYear();
      document.getElementById("experenceYear").innerText =
        experienceYears + "+";
    })
    .catch((error) => {
      console.error("failed to fetch github account age:", error);
      document.getElementById("experenceYear").innerText = "Error";
    });
</script>
